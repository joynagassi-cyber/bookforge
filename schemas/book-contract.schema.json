{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "title",
    "genre",
    "audience",
    "promise",
    "constraints",
    "success_signals"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "promise": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_words": {
      "type": "integer"
    },
    "success_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "superseded"
      ]
    }
  }
}