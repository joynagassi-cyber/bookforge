    "edge":{"type":"object","properties":{"from":{"type":"string"},"to":{"type":"string"},"type":{"type":"string"},"properties":{"type":"object"}}},
    "source_artifact":{"type":"string"},"source_hash":{"type":"string"},"timestamp":{"type":"string"},"actor":{"type":"string"}
  }
}
