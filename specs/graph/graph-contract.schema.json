{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","required":["event_id","operation","entity"],
  "properties":{
    "event_id":{"type":"string"},"operation":{"enum":["upsert_node","upsert_edge","delete_node","delete_edge","snapshot"]},
