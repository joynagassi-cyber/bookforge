{
  "name": "bookforge-framework",
  "version": "2.5.16",
  "description": "Agnostic agentic framework for rigorous book production with plugin, workflow, context and graph runtimes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bookforge": "bin/bookforge.js"
  },
  "files": [
    "bin",
    "lib",
    "agents",
    "skills",
    "workflows",
    "catalogs",
    "knowledge",
    "schemas",
    "manifests",
    "templates",
    "docs",
    "adapters",
    "runtime",
    "specs",
    "scripts",
    "project-templates",
    "bookforge",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "bookforge.yaml"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joynagassi-cyber/bookforge.git"
  },
  "keywords": [
    "ai-agents",
    "book-writing",
    "agentic-framework",
    "context-engineering",
    "knowledge-graph",
    "mcp",
    "ide-agnostic"
  ],
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "validate": "node bin/bookforge.js validate",
    "runtime:test": "node --test tests/runtime/**/*.test.js",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "cursor": "^0.1.5"
  },
  "peerDependenciesMeta": {
    "neo4j-driver": {
      "optional": true
    }
  }
}
